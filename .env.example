# API Keys
BRAVE_API_KEY=your_brave_api_key_here
LLM_API_KEY=EMPTY

# Smart Model Configuration (vLLM)
# Default: Qwen3-32B-AWQ running on vLLM
MODEL_NAME=Qwen/Qwen3-32B-AWQ
LLM_BASE_URL=http://localhost:8000/v1

# Mid-Tier Model Configuration (Ollama)
# NOTE: MID_MODEL_NAME / MID_LLM_BASE_URL are no longer used — translation is
# handled natively by the smart model. Kept for backward compatibility only.
MID_MODEL_NAME=qwen3.5:9b
MID_LLM_BASE_URL=http://localhost:11434/v1

# Fast Model (Ollama) — REMOVED 2026-08-10.
# FAST_MODEL_NAME / FAST_LLM_BASE_URL are gone. Measured on the GB10 box the "fast"
# model decoded at 21 tok/s vs the smart model's 27, because Ollama runs on CPU while
# vLLM holds the GPU. Every LLM call now goes to LLM_BASE_URL above.

# Podcast Configuration
PODCAST_TOPIC=
PODCAST_LANGUAGE=en
ACCESSIBILITY_LEVEL=simple
PODCAST_HOSTS=random

# Upload Platform Credentials
BUZZSPROUT_API_KEY=
BUZZSPROUT_ACCOUNT_ID=
YOUTUBE_CLIENT_SECRET_PATH=./client_secret.json
