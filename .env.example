# API Keys
BRAVE_API_KEY=your_brave_api_key_here
LLM_API_KEY=EMPTY

# Smart Model Configuration (vLLM)
# Default: Qwen3-32B-AWQ running on vLLM
MODEL_NAME=Qwen/Qwen3-32B-AWQ
LLM_BASE_URL=http://localhost:8000/v1

# Mid-Tier Model Configuration (Ollama)
# NOTE: MID_MODEL_NAME / MID_LLM_BASE_URL are no longer used — translation is
# handled natively by the smart model. Kept for backward compatibility only.
MID_MODEL_NAME=qwen3.5:9b
MID_LLM_BASE_URL=http://localhost:11434/v1

# Fast Model (Ollama) — REMOVED 2026-08-10.
# FAST_MODEL_NAME / FAST_LLM_BASE_URL are gone. Measured on the GB10 box the "fast"
# model decoded at 21 tok/s vs the smart model's 27, because Ollama runs on CPU while
# vLLM holds the GPU. Every LLM call now goes to LLM_BASE_URL above.

# Podcast Configuration
PODCAST_TOPIC=
PODCAST_LANGUAGE=en
ACCESSIBILITY_LEVEL=simple
PODCAST_HOSTS=random

# Buzzsprout / YouTube upload credentials — REMOVED 2026-08-14 with
# tools/upload_utils.py. No code reads these names any more; grep confirms zero
# references outside test fixtures. (podcast_tasks.json records written by the
# old version can still carry them, which is why web_ui.py keeps a filter.)

# --- Self-hosted publishing (Cloudflare R2) ---
# The show is served from one R2 bucket behind a custom domain: MP3 enclosures,
# artwork, and feed.xml are all objects in it. `python -m dr2_podcast.publish`
# needs these four to upload anything; everything before the upload (`add`,
# `artwork`, `stage --no-upload`, `sync --dry-run`) runs without them.
#
# Create the token in the Cloudflare dashboard, scoped to *Object Read & Write*
# on this one bucket. The public base URL is NOT a secret and lives in
# podcast/episodes.json as show.base_url instead.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rejuvelab-podcast
